<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.0.1</Version>
    <Author>JustPixelll</Author>
    <Name>All My Glams</Name>
    <Punchline>Your glamour, Glamourer and Penumbra outfit workspace.</Punchline>
    <Description>Use your character as the viewer for a live equipment dresser, reuse Glamourer designs, keep a local wardrobe, manage Penumbra outfit mods, and import cached public glamour recipes.</Description>
    <RepoUrl>https://github.com/JustPixelll/AllMyGlams</RepoUrl>
    <Tags>glamour;glamourer;penumbra;mods;wardrobe;utility</Tags>
    <CategoryTags>utility;other</CategoryTags>
    <Changelog>v0.2.0.1: updater/load hotfix; remove external EC parser dependency and defer automatic IPC refresh until after plugin load.</Changelog>
    <AcceptsFeedback>true</AcceptsFeedback>
    <FeedbackMessage>Please report bugs and feature requests on GitHub.</FeedbackMessage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
